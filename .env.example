# Copy this file to .env and fill in the values.
# These are read by the Supabase client in lib/supabase.ts.
# The EXPO_PUBLIC_ prefix is required to expose them to the app at runtime.
#
# For local development, run `npm run db:start` and use the URL + anon key
# that the Supabase CLI prints (the API URL is typically http://127.0.0.1:54321).
# When testing on a physical device, replace 127.0.0.1 with your computer's
# LAN IP address so the device can reach the local Supabase stack.

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
